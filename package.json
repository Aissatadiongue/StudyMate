{
  "name": "studymate",
  "version": "1.0.0",
  "description": "Plateforme d'entraide académique pour étudiants",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently -n serveur,css -c blue,magenta \"nodemon server/server.js --ignore public/\" \"npm run watch:css\"",
    "build:css": "tailwindcss -i styles/app.css -o public/css/style.css --minify",
    "watch:css": "tailwindcss -i styles/app.css -o public/css/style.css --watch",
    "build": "npm run build:css",
    "db:init": "node server/database/init.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3"
  }
}
