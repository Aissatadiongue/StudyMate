# Copiez ce fichier en .env et remplissez les valeurs (voir README).
# Ne publiez JAMAIS le fichier .env sur GitHub.

PORT=3000

# Longue chaîne aléatoire, différente pour chaque environnement.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=a-changer

# --- Supabase ---------------------------------------------------
# Base de données : Supabase → bouton "Connect" → "Session pooler" → URI
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# Fichiers : Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "service_role" (secrète, tous les droits) : seulement côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# Uniquement pour une base PostgreSQL locale sans chiffrement
# DATABASE_SSL=false
